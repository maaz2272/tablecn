# Postgres connection string (Neon, Vercel Postgres, Supabase, or any Postgres 14+ works)
# Example (Neon): postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional: only needed if you want server actions to call an API on a
# different origin than the app itself. On Vercel this is auto-derived from
# VERCEL_URL, so you usually don't need to set this in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# How many fake tasks the seed script inserts (default 500)
SEED_COUNT=500
